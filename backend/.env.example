# Leave unset for ephemeral in-memory persistence.
SURGE_PREP_MONGODB_URI=mongodb://localhost:27017
SURGE_PREP_MONGODB_DATABASE=surge_prep

# Use memory while integrating API clients; use sofa for the complete demo.
# Showcase mode requires the host SOFA install. Never present memory as real physics.
SURGE_PREP_SIMULATION_BACKEND=sofa
SURGE_PREP_SOFA_SCENE=../simulation/sofa_scene.py

# --- Optional API features (all fall back gracefully when unset) ---------------------------------
# AI coaching after a run. 'auto' uses OpenAI, then Gemini, then the built-in rubric coach.
SURGE_PREP_COACH_PROVIDER=auto
OPENAI_API_KEY=
SURGE_PREP_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
SURGE_PREP_GEMINI_MODEL=gemini-2.0-flash
# Spoken coaching (text to speech)
ELEVENLABS_API_KEY=
SURGE_PREP_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Observability (needs: pip install "./backend[observability]")
SENTRY_DSN=
